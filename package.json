{
  "name": "im-training-agent",
  "version": "1.0.0",
  "description": "面向挑战杯的领域知识个性化生成与多智能体协同训练系统",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./orchestration": {
      "types": "./dist/orchestration.d.ts",
      "import": "./dist/orchestration.mjs",
      "require": "./dist/orchestration.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.mjs",
      "require": "./dist/memory.js"
    },
    "./collaboration": {
      "types": "./dist/collaboration.d.ts",
      "import": "./dist/collaboration.mjs",
      "require": "./dist/collaboration.js"
    },
    "./communication": {
      "types": "./dist/communication.d.ts",
      "import": "./dist/communication.mjs",
      "require": "./dist/communication.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.mjs",
      "require": "./dist/models.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.mjs",
      "require": "./dist/workflow.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "server": "pnpm exec tsx server/index.ts",
    "dev:web": "pnpm --dir web dev",
    "dev:full": "concurrently \"pnpm server\" \"pnpm dev:web\"",
    "data:metropt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-metropt.ps1",
    "start": "node dist/server.js"
  },
  "keywords": [
    "multi-agent",
    "agent",
    "ai",
    "orchestration",
    "collaboration",
    "agentic",
    "llm",
    "deepseek",
    "openai",
    "tool-calling",
    "function-calling",
    "agent-cluster",
    "task-planning",
    "sequential",
    "parallel",
    "debate",
    "expert-team",
    "critic-reviewer",
    "hierarchical",
    "learning",
    "evidence-grounded"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^10.0.3",
    "eslint": "^8.56.0",
    "tsup": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^6.39.1"
  }
}
