# 默认主模型：通义千问 / DashScope
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 可选备用模型
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：服务端口（默认 3001）
# PORT=3001

# 可选：MetroPT-3 CSV 自定义位置；默认使用 data/datasets/metropt/MetroPT3(AirCompressor).csv
# IM_TRAINING_AGENT_METROPT_CSV=D:/datasets/MetroPT3(AirCompressor).csv

# ---------- 挑战杯平台基础设施（docs/挑战杯技术开发总规.md） ----------
# PostgreSQL 唯一业务数据源；Redis 只负责 BullMQ 队列、锁与 run 事件分发
DATABASE_URL=postgres://im_training:im_training_dev@localhost:5432/im_training
REDIS_URL=redis://localhost:6379

# docker compose 环境变量（与 DATABASE_URL 保持一致）
# POSTGRES_USER=im_training
# POSTGRES_PASSWORD=im_training_dev
# POSTGRES_DB=im_training
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# 嵌入模型：阿里云 text-embedding-v4，固定 1024 维（总规 §7.5）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# 演示账号种子密码：只能由环境注入，禁止提交真实值（总规 §8.1）
# IM_TRAINING_AGENT_DEMO_PASSWORD=
